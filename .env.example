# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=catalog_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catalog_db?sslmode=disable

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Set AWS_ENDPOINT to http://localhost:4566 when using LocalStack
AWS_ENDPOINT=http://localhost:4566

# SNS Topics (ARNs from LocalStack or AWS)
SNS_TOPIC_STOCK_RESERVED_ARN=arn:aws:sns:us-east-1:000000000000:catalog-events-topic
SNS_TOPIC_BACKORDER_CREATED_ARN=arn:aws:sns:us-east-1:000000000000:catalog-events-topic
SNS_TOPIC_STOCK_INSUFFICIENT_ARN=arn:aws:sns:us-east-1:000000000000:catalog-events-topic

# Server Configuration
HTTP_PORT=8080
JWT_SECRET=change-me-in-production
